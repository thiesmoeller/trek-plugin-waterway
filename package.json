{
  "name": "trek-plugin-waterway",
  "version": "1.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "ci": "npm run test:coverage && npm run validate && npm run pack",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "WATERWAY_LIVE_OVERPASS=1 vitest run tests/live-*.test.js",
    "dev": "npx trek-plugin-sdk dev",
    "pack": "npx trek-plugin-sdk pack",
    "validate": "npx trek-plugin-sdk validate"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "trek-plugin-sdk": "^1.7.0",
    "vitest": "^5.0.0"
  }
}

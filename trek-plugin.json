{
  "id": "waterway",
  "name": "Waterway Route Provider",
  "version": "1.0.0",
  "apiVersion": 1,
  "author": "TREK",
  "description": "Route day plans along OSM rivers, canals, and fairways via Overpass with rough rowing duration estimates.",
  "homepage": "https://github.com/thiesmoeller/trek-plugin-waterway",
  "license": "MIT",
  "icon": "Waves",
  "type": "integration",
  "trek": ">=4.0.0 <5.0.0",
  "nativeModules": false,
  "permissions": [
    "hook:route-provider",
    "db:own",
    "http:outbound:overpass-api.de"
  ],
  "settings": [
    {
      "key": "overpassUrl",
      "label": "Overpass URL",
      "input_type": "text",
      "scope": "instance",
      "placeholder": "https://overpass-api.de/api/interpreter",
      "hint": "Optional Overpass API interpreter endpoint. Custom hosts must also be listed in egress."
    },
    {
      "key": "speedKmh",
      "label": "Average rowing speed (km/h)",
      "input_type": "number",
      "scope": "instance",
      "placeholder": "6",
      "hint": "Used for waterway duration estimates."
    },
    {
      "key": "defaultLockDelayMinutes",
      "label": "Default lock delay (minutes)",
      "input_type": "number",
      "scope": "instance",
      "placeholder": "15",
      "hint": "Added to route duration for each detected lock."
    }
  ],
  "egress": [
    "overpass-api.de"
  ],
  "capabilities": {
    "routeProfiles": [
      {
        "id": "waterway",
        "label": "Waterway"
      }
    ]
  }
}

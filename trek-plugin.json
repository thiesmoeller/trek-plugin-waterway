{
  "id": "waterway",
  "name": "Waterway Route Provider",
  "version": "1.1.0",
  "apiVersion": 1,
  "author": "Thies Möller",
  "description": "Route day plans along OSM rivers, canals, and fairways via Overpass with rough paddle and rowing duration estimates.",
  "homepage": "https://github.com/thiesmoeller/trek-plugin-waterway",
  "license": "MIT",
  "icon": "Waves",
  "type": "integration",
  "trek": ">=4.2.0 <5.0.0",
  "nativeModules": false,
  "permissions": [
    "hook:route-provider",
    "mcp:tools",
    "db:own",
    "http:outbound:overpass-api.de"
  ],
  "settings": [
    {
      "key": "overpassUrl",
      "label": "Overpass URL",
      "input_type": "text",
      "scope": "instance",
      "placeholder": "https://overpass-api.de/api/interpreter",
      "hint": "Optional Overpass API interpreter endpoint. Custom hosts must also be listed in egress."
    },
    {
      "key": "canoeSpeedKmh",
      "label": "Average canoe speed (km/h)",
      "input_type": "number",
      "scope": "instance",
      "placeholder": "5",
      "default": 5,
      "hint": "Used for canoe duration estimates."
    },
    {
      "key": "kayakSpeedKmh",
      "label": "Average kayak speed (km/h)",
      "input_type": "number",
      "scope": "instance",
      "placeholder": "6",
      "default": 6,
      "hint": "Used for kayak duration estimates."
    },
    {
      "key": "rowingSpeedKmh",
      "label": "Average rowing speed (km/h)",
      "input_type": "number",
      "scope": "instance",
      "placeholder": "8",
      "default": 8,
      "hint": "Used for rowing duration estimates."
    },
    {
      "key": "optimisticLockDelayMinutes",
      "label": "Optimistic lock time (minutes)",
      "input_type": "number",
      "scope": "instance",
      "placeholder": "15",
      "default": 15,
      "hint": "Best case per lock when entry is immediate."
    },
    {
      "key": "defaultLockDelayMinutes",
      "label": "Planning lock time (minutes)",
      "input_type": "number",
      "scope": "instance",
      "placeholder": "25",
      "default": 25,
      "hint": "Expected time per lock used for the route shown on the map."
    },
    {
      "key": "conservativeLockDelayMinutes",
      "label": "Conservative lock time (minutes)",
      "input_type": "number",
      "scope": "instance",
      "placeholder": "40",
      "default": 40,
      "hint": "Contingency case per lock for daylight and deadline checks."
    }
  ],
  "actions": [
    {
      "key": "purgeCache",
      "label": "Purge Overpass cache",
      "hint": "Drop cached waterway queries so the next route fetches fresh OSM data.",
      "scope": "instance"
    }
  ],
  "egress": [
    "overpass-api.de"
  ],
  "capabilities": {
    "routeProfiles": [
      {
        "id": "canoe",
        "label": "Canoe",
        "icon": "Waves"
      },
      {
        "id": "kayak",
        "label": "Kayak",
        "icon": "Sailboat"
      },
      {
        "id": "rowing",
        "label": "Rowing",
        "icon": "Ship"
      }
    ],
    "mcpTools": [
      {
        "name": "estimate_route",
        "title": "Estimate waterway route",
        "description": "Estimate a canoe, kayak, or rowing route through supplied waypoints. Returns optimistic, planning, and conservative lock-time scenarios, per-leg distance and duration, operational warnings, and optional simplified geometry.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile": {
              "type": "string",
              "enum": ["canoe", "kayak", "rowing"],
              "description": "Watercraft profile used for access rules and speed estimates."
            },
            "waypoints": {
              "type": "array",
              "minItems": 2,
              "maxItems": 30,
              "description": "Ordered start, intermediate, and destination coordinates.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 120,
                    "description": "Optional human-readable stop name."
                  },
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "lng": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  }
                },
                "required": ["lat", "lng"]
              }
            },
            "includeGeometry": {
              "type": "boolean",
              "default": false,
              "description": "Include map geometry simplified to at most 200 coordinates."
            },
            "lockScenario": {
              "type": "string",
              "enum": ["optimistic", "planning", "conservative"],
              "default": "planning",
              "description": "Scenario used for the primary estimate; all three scenario totals are returned."
            },
            "lockMinutes": {
              "type": "object",
              "additionalProperties": false,
              "description": "Optional per-request lock-time overrides; these do not change instance settings.",
              "properties": {
                "optimistic": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1440
                },
                "planning": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1440
                },
                "conservative": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1440
                }
              }
            }
          },
          "required": ["profile", "waypoints"]
        },
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true
        }
      }
    ]
  }
}
